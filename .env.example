# ── OpenAI ───────────────────────────────────────────────────────────────────
OPENAI_API_KEY=

# ── URLs (set per deployment environment) ────────────────────────────────────
# The origin the frontend runs on — used for CORS allowlist in the backend.
# Accepts a comma-separated list so you can allow both local and production.
FRONTEND_ORIGIN=http://localhost:3000

# The API base URL the Next.js frontend calls.
# In production this should be your Azure Container Instances URL.
NEXT_PUBLIC_API_URL=http://localhost:8000

# ── NVD API (optional) ───────────────────────────────────────────────────────
# Raises the NIST NVD rate limit from 5 to 50 requests per 30 seconds.
# Register at https://nvd.nist.gov/developers/request-an-api-key
NVD_API_KEY=

# ── Study controls ───────────────────────────────────────────────────────────
# Set to "false" to return 503 on all session and baseline routes instantly,
# without redeploying. Useful for closing enrolment mid-study.
STUDY_OPEN=true

# Maximum number of participants (informational — not enforced by the backend).
MAX_PARTICIPANTS=56

# ── Participant registration ──────────────────────────────────────────────────
# Secret the Google Apps Script sends when registering a new participant via
# POST /participants/register. Generate with: python -c "import secrets; print(secrets.token_hex(32))"
# Must be set — the endpoint returns 401 if the key is missing or wrong.
PARTICIPANT_REGISTER_KEY=

# ── Monitoring ───────────────────────────────────────────────────────────────
# Protects GET /participants/status. Leave empty to allow unauthenticated access
# (only do this on a private network). Set to a random secret in production.
MONITORING_API_KEY=

# ── Langfuse (optional — tracing and LLM-as-judge evaluation) ────────────────
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com
